#!/bin/sh
# Opens Advanced Disk Analyzer in its own window. Starts the server if it is not running,
# and stops it again when the window is closed.
PORT=8792
URL=http://127.0.0.1:$PORT
BIN="$HOME/.local/share/advanced-disk-analyzer/disk-analyzer"
PROFILE="$HOME/.local/share/advanced-disk-analyzer/window-profile"
LOG="$HOME/.local/share/advanced-disk-analyzer/server.log"

started=
if ! curl -s -o /dev/null "$URL/api/status"; then
  PORT=$PORT "$BIN" >"$LOG" 2>&1 &
  started=$!
  for _ in $(seq 50); do curl -s -o /dev/null "$URL/api/status" && break; sleep 0.1; done
fi

for b in google-chrome chromium chromium-browser; do
  if command -v "$b" >/dev/null; then
    # A separate profile makes this a standalone window that blocks until closed.
    "$b" --app="$URL" --user-data-dir="$PROFILE" --no-first-run --window-size=1400,950
    break
  fi
done || xdg-open "$URL"

[ -n "$started" ] && kill "$started"
