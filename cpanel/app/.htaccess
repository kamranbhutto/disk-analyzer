# Advanced Disk Analyzer: only the dashboard and its API are reachable from the web.
Options -Indexes
<FilesMatch "^(lib|auth)\.php$|\.(html|json|sqlite|md)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>
