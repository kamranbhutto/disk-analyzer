#!/usr/bin/env python3
"""Stand-in for WHM's whmapi1 command, used only by the local tests.
Accounts come from the JSON file named in FAKE_WHM_ACCOUNTS."""
import json, os, sys

func = sys.argv[2] if sys.argv[1].startswith("--output") else sys.argv[1]
accounts = json.load(open(os.environ["FAKE_WHM_ACCOUNTS"]))
ok = {"result": 1, "reason": "OK"}
if func == "listaccts":
    acct = [{"user": a["user"], "domain": a["domain"], "owner": a.get("owner", "root"), "plan": a.get("plan", "default"),
             "suspended": int(a.get("suspended", 0)), "email": a.get("email", ""), "diskused": f"{a['used_kb'] // 1024}M",
             "disklimit": f"{a['limit_kb'] // 1024}M" if a["limit_kb"] else "unlimited"} for a in accounts]
    print(json.dumps({"metadata": ok, "data": {"acct": acct}}))
elif func == "get_disk_usage":
    print(json.dumps({"metadata": ok, "data": {"accounts": [{"user": a["user"], "blocks_used": a["used_kb"], "blocks_limit": a["limit_kb"],
          "inodes_used": a["inodes"], "inodes_limit": a.get("inode_limit", 0)} for a in accounts]}}))
elif func == "get_tweaksetting":
    print(json.dumps({"metadata": ok, "data": {"tweaksetting": {"key": "contactemail", "value": "admin@example.net"}}}))
else:
    print(json.dumps({"metadata": {"result": 0, "reason": f"Unknown function {func}"}}))
